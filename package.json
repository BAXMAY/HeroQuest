{
  "name": "heroquest",
  "version": "2.0.0",
  "private": true,
  "description": "HeroQuest monorepo: legacy Next.js + Firebase app and v2 TanStack Start + Cloudflare rebuild.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=v2...",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:gen": "pnpm -F @heroquest/db gen",
    "db:migrate:local": "pnpm -F v2 db:migrate:local",
    "db:migrate:prod": "pnpm -F v2 db:migrate:prod",
    "db:seed": "pnpm -F v2 db:seed",
    "demo:setup": "cp apps/v2/.dev.vars.demo apps/v2/.dev.vars",
    "demo": "pnpm demo:setup && pnpm -F v2 demo",
    "deploy": "pnpm -F v2 deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
