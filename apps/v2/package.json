    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.1.8",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.95.0"
  }
}
