{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "heroquest-v2",
  // worker.ts wraps dist/server/server.js with an AsyncLocalStorage that
  // captures Workers' (request, env, ctx) env so getEnv() works inside
  // server fns / Better Auth handler. See apps/v2/worker.ts.
  "main": "./worker.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heroquest",
      "database_id": "05b71bdb-c07c-4a6e-bb0a-9cbfb4ed2696",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "QUEST_PHOTOS", "bucket_name": "heroquest-quest-photos" },
    { "binding": "AVATARS", "bucket_name": "heroquest-avatars" },
    { "binding": "BRAND_ASSETS", "bucket_name": "heroquest-brand-assets" }
  ],
  "kv_namespaces": [
    { "binding": "TRIVIA_KV", "id": "a51491c5d83a48f4a4099f9ddc04c9dd" }
  ],
  "triggers": {
    "crons": [
      "5 17 * * *",
      "10 17 * * *"
    ]
  }
}
